--- !u!114 &788022330
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 788022326}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 28072a6b914692e468293d8c71358ade, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  charDatas:
  - name: "\uC544\uC2A4\uD2B8\uB784\uB85C"
    text: "\uC131\uACF5\uC801\uC778\n\uD0D0\uC0AC\uC600\uB2E4\uB124!"
    failText: "\uD3EC\uAE30\uD558\uC9C0 \uB9D0\uAC8C\uB098!"
    portrait: {fileID: 21300000, guid: eede1318a366082468f83346fcba67a7, type: 3}
  - name: "\uCD5C\uC774\uC11C"
    text: "\u3145..\uC131\uACF5\uD588\uC5B4\uC694!"
    failText: "\uC2E4\uD328\uD588\uC5B4\uC694.."
    portrait: {fileID: 21300000, guid: cfdd6d59e22de4248b5ea1265184020d, type: 3}
  - name: "\uC2A4\uCE7C\uB77C \uC6B0\uC774"
    text: "\uC774\uC815\uB3C4\uB294\n\uC2DD\uC740 \uC8FD \uBA39\uAE30\uC9C0~"
    failText: "\uCCC7.."
    portrait: {fileID: 21300000, guid: d4ba43d4ff12a6f4987b4ed1c6b48beb, type: 3}
  - name: "Dr.\uD2B8\uB9AC\uAC70"
    text: "\uC774\uAC8C \uBC14\uB85C\n\uC8FD\uC774\uB294 \uD300\uC6CC\uD06C\uAC70\uB4E0!"
    failText: "\uC73C\uC545!\n\uBE68\uB9AC \uAD6C\uAE09\uCC28 \uBD88\uB7EC!"
    portrait: {fileID: 21300000, guid: 6e422ce094caa6a4d8dfb87aafb306cb, type: 3}
  - name: "\uD0C4\uC81C\uD0C0"
    text: "\uB2E4\uB4E4\n\uC218\uACE0\uD588\uC5B4.."
    failText: "\uC774\uC81C \uC274 \uC218 \uC788\uC5B4.."
    portrait: {fileID: 21300000, guid: b557e98f067dd374aa6d7db03c380c1b, type: 3}
  - name: "\uD5E4\uC138\uB4DC"
    text: "\uB05D\uB098\uACE0 \uB9DB\uC788\uB294\uAC70\n\uBA39\uC73C\uB7EC \uAC08
      \uC0AC\uB78C!?"
    failText: "\uAD1C\uCC2E\uC544\n\uB2E4\uC2DC \uD574\uBCF4\uC790!"
    portrait: {fileID: 21300000, guid: c6fc0b8223242414b96f268c93616d50, type: 3}
  - name: "\uC6DC\uD4E8\uD130"
    text: GG
    failText: 404 NOT FOUNT
    portrait: {fileID: 21300000, guid: f817c0d0ae0673b4f9c1e0f192e8308c, type: 3}
  - name: "\uC568\uB9AC\uC2A4"
    text: "\uB2E4\uB4E4 \uC5EC\uAE30\n\uBCF4\uACE0 \uCE58\uC988~"
    failText: "\uC5B8\uB2C8\uAC00..\n\uB3C4\uC640\uC8FC\uB7EC \uC62C\uAC70\uC57C.."
    portrait: {fileID: 21300000, guid: d58e1be489c4e984e85866872ad26dc8, type: 3}
  - name: "\uD30C\uC218\uAFBC"
    text: "\uC774\uBC88\uC5D4 \uBAA8\uB450\n\uC9C0\uCF1C\uB0C8\uC2B5\uB2C8\uB2E4."
    failText: "\uB09C \uBB34\uC5C7\uC744\n\uC9C0\uD0A4\uB824 \uD55C\uAC83\uC778\uAC00.."
    portrait: {fileID: 21300000, guid: be14879d45f8c5f4ba7ccea3eb5b7b7a, type: 3}
  - name: "\uC548\uC824\uB77C"
    text: "\uC720\uB808\uCE74~!\n\uC774\uAC8C \uBC14\uB85C \uACFC\uD559\n\uAE30\uC220\uC5D0
      \uC704\uB300\uD568\uC774\uC9C0! "
    failText: "\uC2E4\uD328\uB294 \uC131\uACF5\uC5D0\n\uC5B4\uBA38\uB2C8\uB77C\uACE0!"
    portrait: {fileID: 21300000, guid: afb7dcaf9c32a87478ba65b68d60c8ac, type: 3}
  rankBadge:
  - {fileID: 1991460850, guid: 38990f15caea8184b81f624c3940b1f7, type: 3}
