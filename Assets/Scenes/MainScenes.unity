    charInfo: "\uD328\uC2DC\uBE0C:\uC801\uC744 \uCC98\uCE58\n\uD560\uB54C \uC2A4\uD0AC
      \uD3EC\uC778\uD2B8\uB97C 1\uD68C\uBCF5\n\uD569\uB2C8\uB2E4 [\uD544\uC694 \uCDA9\uC804\uB7C9:4]"
