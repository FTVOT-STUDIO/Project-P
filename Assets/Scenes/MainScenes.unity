  - charName: "\uD30C\uC218\uAFBC"
    skillName: "\uBD88\uC644\uC804\uD55C \uAC80"
    charInfo: "\uD328\uC2DC\uBE0C:\uC801\uC744 \uCC98\uCE58\n\uD560\uC2DC \uC601\uAD6C\uC801\uC73C\uB85C
      \n\uACF5\uACA9\uB825\uC774 0.5\uC99D\uAC00\uD569\uB2C8\uB2E4."
    SkillInfo: "\uC2A4\uD0AC \uC0AC\uC6A9\uC2DC \uBC30\uAE30\uC640 \uB300\uC26C\uB97C
      \uBC88\uAC08\uC544\n\uAC00\uBA70 \uACF5\uACA9\uD569\uB2C8\uB2E4 \uBC30\uAE30
      \uC0C1\uD0DC\uC5D0\uC11C \n\uC810\uD504\uD560\uC2DC \uACF5\uC911\uC73C\uB85C
      \uB3C4\uC57D\uD558\uACE0, \uB300\uC26C \n\uC0C1\uD0DC\uC5D0\uC11C \uC810\uD504\uD560\uC2DC
      \uBE60\uB974\uAC8C \uCC29\uC9C0\uD569\uB2C8\uB2E4\n"
    portrait: {fileID: 1172939589, guid: 40bfdf4750496de45b623bbc105940ff, type: 3}
