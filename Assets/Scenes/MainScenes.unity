    health: 0
    speed: 0
  - charName: "\uD0C4_\uC81C\uD0C0"
    skillName: "\uD2B9\uC774\uC810 \uD3ED\uBC1C"
    charInfo: "\uD328\uC2DC\uBE0C:\uC0DD\uBA85\uB825\uC774\n\uB300\uD3ED \uC99D\uAC00\uD558\uB294
      \uB300\uC2E0\n\uACF5\uACA9\uB825\uC774 0.1\uB85C \uAC10\uC18C\uD569\uB2C8\uB2E4"
