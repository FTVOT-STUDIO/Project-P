  charData:
  - charName: "\uC544\uC2A4\uD2B8\uB784\uB85C"
    skillName: "\uC288\uD2B8\n\uC624\uBC84\uD074\uB7ED"
    charInfo: "\uD328\uC2DC\uBE0C:\uC774\uB3D9\uACFC \n\uC810\uD504\uAC00 \uAC00\uB2A5\uD558\uB2E4!"
    SkillInfo: "\uC2A4\uD0AC \uC0AC\uC6A9\uC2DC \uC790\uC2E0\uC758 \uC288\uD2B8\uC5D0\n\uACFC\uBD80\uD558\uB97C
      \uAC78\uC5B4 20\uCD08 \uB3D9\uC548\n\uACF5\uACA9\uB825\uACFC \uC810\uD504\uB825\uC744
      2\uBC30 \n\uC0C1\uC2B9\uC2DC\uD0B5\uB2C8\uB2E4"
    portrait: {fileID: -274006803, guid: ead06f9d41360134e80bac2136414c2f, type: 3}
    skillIcon: {fileID: -2088613149, guid: 17c6a1088f1bf164cb81889ebbe5aa51, type: 3}
    sdIllrust: {fileID: 21300000, guid: eede1318a366082468f83346fcba67a7, type: 3}
    videoClips: {fileID: 32900000, guid: e8d2a4d3a80903a4ea92f3b1a148b610, type: 3}
    damage: 0
    health: 0
    speed: 0
  - charName: "\uCCB4\uC774\uC11C"
    skillName: ERR 404
    charInfo: "\uD328\uC2DC\uBE0C:\uAC00\uC7A5 \uBE60\uB978\n\uAE30\uCD08 \uC18D\uB3C4\uB97C
      \uAC00\uC9C0\uACE0\uC788\uB2E4"
    SkillInfo: "\uC11C\uBC84\uB97C \uD574\uD0B9\uD558\uC5EC \uBC14\uB77C\uBCF4\uB294
      \n\uBC29\uD5A5\uC73C\uB85C \uC790\uC2E0\uC758 \uC704\uCE58\uB97C \uBC14\uAFB8\uACE0\n5\uCD08\uAC04
      \uC18D\uB3C4\uAC00 20% \uC99D\uAC00\uD569\uB2C8\uB2E4"
    portrait: {fileID: -904299494, guid: a7635985775d66341a49845ce14daec2, type: 3}
    skillIcon: {fileID: 1067529337, guid: 17c6a1088f1bf164cb81889ebbe5aa51, type: 3}
    sdIllrust: {fileID: 21300000, guid: cfdd6d59e22de4248b5ea1265184020d, type: 3}
    videoClips: {fileID: 32900000, guid: becb982bd847f3e47a1d546f736a2cc9, type: 3}
    damage: 0
    health: 0
    speed: 0
  - charName: "\uC2A4\uCE7C\uB77C\uC6B0\uC774"
    skillName: "\uB048\uC9C8\uAE34 \n\uC0DD\uBA85\uC758 \uADFC\uC6D0"
    charInfo: "\uD328\uC2DC\uBE0C:\uCCB4\uB825\uC740 \uC801\uC9C0\uB9CC\n\uAC00\uC7A5
      \uAC15\uB825\uD55C \uAE30\uCD08\n\uACF5\uACA9\uB825\uC744 \uAC00\uC9C0\uACE0
      \uC788\uB2E4!"
    SkillInfo: "\uC2A4\uD0AC \uC0AC\uC6A9\uC2DC \uD638\uB4DC\uC758 \uD798\uC73C\uB85C\n20\uCD08\uB3D9\uC548
      \uD53C\uD574 \uBA74\uC5ED \uC0C1\uD0DC\uAC00 \n\uB418\uACE0 \uACF5\uACA9\uB825\uC774
      2\uBC30 \uC99D\uAC00\uB429\uB2C8\uB2E4"
    portrait: {fileID: 979629632, guid: c17d6d12f12a73544a27b4d7d37e5fba, type: 3}
    skillIcon: {fileID: 1046415102, guid: 7c63117e185fb0448b35dc79f3ab3bf7, type: 3}
    sdIllrust: {fileID: 21300000, guid: d4ba43d4ff12a6f4987b4ed1c6b48beb, type: 3}
    videoClips: {fileID: 32900000, guid: bb315d399638c604da7875a25fc3097c, type: 3}
    damage: 0
    health: 0
    speed: 0
  - charName: "Dr.\uD2B8\uB9AC\uAC70"
    skillName: "\uC57D\uBB3C \uC8FC\uC0AC"
    charInfo: "\uD328\uC2DC\uBE0C:\uCCB4\uB825 \uAC1C\uC218\uC5D0\n\uB530\uB77C \uACF5\uACA9\uB825\uC774\n\uBCC0\uD654\uD569\uB2C8\uB2E4"
    SkillInfo: "\uC2A4\uD0AC \uC0AC\uC6A9\uC2DC \uC790\uC2E0\uC5D0\uAC8C\n\uC57D\uBB3C\uC744
      \uD22C\uC5EC\uD574 \uC989\uC2DC\n\uC0DD\uBA85\uB825 1\uC744 \uD68C\uBCF5\uD569\uB2C8\uB2E4"
    portrait: {fileID: -1614953315, guid: 12354f9e94b534845a5dfc20f87aba73, type: 3}
    skillIcon: {fileID: -1578059053, guid: 9ef4e4756cbfbf445bf95f01fdd444ac, type: 3}
